{
    "name": "@hodfords/nestjs-api-gateway",
    "version": "12.1.0",
    "description": "The API Gateway houses the source code and documentation for the API Gateway - a powerful and versatile solution for managing and deploying APIs within a distributed and microservices-oriented architecture.",
    "author": "",
    "private": false,
    "license": "UNLICENSED",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/hodfords-solutions/nestjs-api-gateway.git"
    },
    "bugs": {
        "url": "https://github.com/hodfords-solutions/nestjs-api-gateway/issues"
    },
    "homepage": "https://opensource.hodfords.uk/",
    "scripts": {
        "prebuild": "rimraf dist *.tsbuildinfo",
        "postbuild": "sh ./scripts/postbuild.sh",
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"libs/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "lint": "eslint",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:cov": "vitest run --coverage"
    },
    "dependencies": {
        "@keyv/redis": "^5.1.6",
        "@modelcontextprotocol/sdk": "^1.28.0",
        "@nestjs/cache-manager": "12.0.0",
        "es-toolkit": "1.51.0",
        "undici": "^7.24.4"
    },
    "devDependencies": {
        "@hodfords/nestjs-eslint-config": "^11.0.4",
        "@hodfords/nestjs-prettier-config": "^11.0.2",
        "@nestjs/axios": "12.0.0",
        "@nestjs/cli": "12.0.0",
        "@nestjs/common": "12.0.1",
        "@nestjs/core": "12.0.1",
        "@nestjs/platform-express": "12.0.1",
        "@nestjs/schedule": "12.0.1",
        "@nestjs/schematics": "12.0.0",
        "@nestjs/swagger": "12.0.0",
        "@nestjs/testing": "12.0.1",
        "@opentelemetry/api": "^1.9.0",
        "@opentelemetry/auto-instrumentations-node": "^0.71.0",
        "@opentelemetry/exporter-trace-otlp-grpc": "^0.213.0",
        "@opentelemetry/exporter-trace-otlp-http": "^0.213.0",
        "@opentelemetry/sdk-node": "^0.213.0",
        "@opentelemetry/sdk-trace-base": "^2.6.0",
        "@swc/core": "^1.13.5",
        "@types/express": "5.0.6",
        "@types/http-proxy": "1.17.17",
        "@types/node": "25.2.0",
        "axios": "1.13.6",
        "camelcase-keys": "10.0.2",
        "dotenv": "17.3.1",
        "eslint": "10.0.3",
        "hbs": "4.2.0",
        "ioredis": "5.10.0",
        "path-to-regexp": "8.3.0",
        "prettier": "3.8.1",
        "reflect-metadata": "0.2.2",
        "rimraf": "6.1.3",
        "rxjs": "7.8.2",
        "source-map-support": "0.5.21",
        "ts-loader": "9.5.4",
        "typescript": "6.0.3",
        "unplugin-swc": "^1.5.7",
        "vitest": "^4.1.10"
    },
    "peerDependencies": {
        "@nestjs/schedule": "*",
        "@nestjs/swagger": "*",
        "axios": "*",
        "hbs": "*",
        "path-to-regexp": "*"
    },
    "type": "module",
    "engines": {
        "node": ">=20.19.0"
    },
    "main": "./index.js",
    "types": "./index.d.ts",
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "import": "./index.js",
            "default": "./index.js"
        },
        "./package.json": "./package.json"
    }
}
