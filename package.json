{
    "name": "@hodfords/nestjs-api-gateway",
    "version": "12.2.0",
    "packageManager": "pnpm@12.0.0",
    "description": "The API Gateway houses the source code and documentation for the API Gateway - a powerful and versatile solution for managing and deploying APIs within a distributed and microservices-oriented architecture.",
    "author": "",
    "private": false,
    "license": "UNLICENSED",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/hodfords-solutions/nestjs-api-gateway.git"
    },
    "bugs": {
        "url": "https://github.com/hodfords-solutions/nestjs-api-gateway/issues"
    },
    "homepage": "https://opensource.hodfords.uk/",
    "scripts": {
        "prebuild": "rimraf dist *.tsbuildinfo",
        "postbuild": "sh ./scripts/postbuild.sh",
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"libs/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "lint": "eslint",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:cov": "vitest run --coverage"
    },
    "dependencies": {
        "@keyv/redis": "^5.1.6",
        "@modelcontextprotocol/sdk": "^1.30.0",
        "camelcase-keys": "^10.0.2",
        "es-toolkit": "1.52.0",
        "undici": "^8.10.0"
    },
    "devDependencies": {
        "@hodfords/nestjs-eslint-config": "^11.0.4",
        "@hodfords/nestjs-prettier-config": "^11.0.2",
        "@nestjs/axios": "12.0.0",
        "@nestjs/cache-manager": "12.0.0",
        "@nestjs/cli": "12.0.0",
        "@nestjs/common": "12.0.1",
        "@nestjs/core": "12.0.1",
        "@nestjs/platform-express": "12.0.1",
        "@nestjs/schedule": "12.0.1",
        "@nestjs/schematics": "12.0.0",
        "@nestjs/swagger": "12.0.1",
        "@nestjs/testing": "12.0.1",
        "@opentelemetry/api": "^1.9.1",
        "@opentelemetry/auto-instrumentations-node": "^0.79.0",
        "@opentelemetry/exporter-trace-otlp-grpc": "^0.221.0",
        "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
        "@opentelemetry/exporter-trace-otlp-proto": "^0.221.0",
        "@opentelemetry/resources": "^2.10.0",
        "@opentelemetry/sdk-node": "^0.221.0",
        "@opentelemetry/sdk-trace-base": "^2.10.0",
        "@opentelemetry/sdk-trace-node": "^2.10.0",
        "@opentelemetry/semantic-conventions": "^1.43.0",
        "@swc/core": "^1.16.1",
        "@types/express": "5.0.6",
        "@types/http-proxy": "1.17.17",
        "@types/node": "26.4.0",
        "axios": "1.20.0",
        "dotenv": "17.4.2",
        "eslint": "10.9.1",
        "hbs": "4.3.0",
        "ioredis": "6.0.0",
        "path-to-regexp": "8.4.2",
        "prettier": "3.9.6",
        "reflect-metadata": "0.2.2",
        "rimraf": "6.1.3",
        "rxjs": "7.8.2",
        "source-map-support": "0.5.21",
        "ts-loader": "9.6.2",
        "typescript": "6.0.3",
        "unplugin-swc": "^1.5.11",
        "vitest": "^4.1.11"
    },
    "peerDependencies": {
        "@nestjs/axios": ">=12.0.0",
        "@nestjs/common": ">=12.0.0",
        "@nestjs/core": ">=12.0.0",
        "@nestjs/schedule": "*",
        "@nestjs/swagger": "*",
        "axios": "*",
        "express": ">=5.0.0",
        "hbs": "*",
        "ioredis": ">=5.0.0",
        "path-to-regexp": "*",
        "rxjs": ">=7.0.0"
    },
    "peerDependenciesMeta": {
        "express": {
            "optional": true
        }
    },
    "type": "module",
    "engines": {
        "node": ">=20.19.0"
    },
    "main": "./index.js",
    "types": "./index.d.ts",
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "import": "./index.js",
            "default": "./index.js"
        },
        "./package.json": "./package.json"
    }
}
