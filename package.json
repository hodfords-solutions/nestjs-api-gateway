{
  "name": "@hodfords/nestjs-api-gateway",
  "version": "11.0.7",
  "description": "The API Gateway houses the source code and documentation for the API Gateway - a powerful and versatile solution for managing and deploying APIs within a distributed and microservices-oriented architecture.",
  "author": "",
  "private": false,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hodfords-solutions/nestjs-api-gateway.git"
  },
  "bugs": {
    "url": "https://github.com/hodfords-solutions/nestjs-api-gateway/issues"
  },
  "homepage": "https://opensource.hodfords.uk/",
  "scripts": {
    "prebuild": "rimraf dist",
    "postbuild": "sh ./scripts/postbuild.sh",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"libs/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@keyv/redis": "4.3.2",
    "@nestjs/cache-manager": "^3.0.0",
    "@squarecloud/http-proxy": "1.2.0"
  },
  "devDependencies": {
    "@hodfords/nestjs-eslint-config": "^11.0.1",
    "@hodfords/nestjs-prettier-config": "^11.0.1",
    "@nestjs/axios": "4.0.0",
    "@nestjs/cli": "11.0.5",
    "@nestjs/common": "11.0.11",
    "@nestjs/core": "11.0.11",
    "@nestjs/platform-express": "11.0.11",
    "@nestjs/schedule": "5.0.1",
    "@nestjs/schematics": "11.0.2",
    "@nestjs/swagger": "11.0.6",
    "@nestjs/testing": "11.0.11",
    "@types/express": "5.0.0",
    "@types/http-proxy": "1.17.16",
    "@types/lodash": "4.17.16",
    "@types/node": "22.13.10",
    "axios": "1.8.3",
    "camelcase-keys": "9.1.3",
    "dotenv": "16.4.7",
    "eslint": "9.22.0",
    "hbs": "4.2.0",
    "ioredis": "5.6.0",
    "lodash": "4.17.21",
    "path-to-regexp": "8.2.0",
    "prettier": "3.5.3",
    "reflect-metadata": "0.2.2",
    "rimraf": "6.0.1",
    "rxjs": "7.8.2",
    "source-map-support": "0.5.21",
    "ts-loader": "9.5.2",
    "typescript": "5.8.2"
  },
  "peerDependencies": {
    "@nestjs/schedule": "*",
    "@nestjs/swagger": "*",
    "axios": "*",
    "hbs": "*",
    "path-to-regexp": "*"
  }
}
