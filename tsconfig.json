{
    "compilerOptions": {
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "target": "es2023",
        "strictPropertyInitialization": false,
        "types": ["node"],
        "lib": ["es2023"],
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "declaration": true,
        "removeComments": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "sourceMap": true,
        "skipLibCheck": true,
        "outDir": "./dist",
        "incremental": true,
        "resolveJsonModule": true,
        "paths": {
            "~*": ["./src/*"],
            "@hodfords/api-gateway": ["./libs/api-gateway/index.ts"],
            "@hodfords/api-gateway-client": ["./libs/client/index.ts"],
            "@hodfords/http-proxy": ["./libs/http-proxy/index.ts"]
        }
    },
    "include": ["libs", "src", "test"],
    "exclude": ["node_modules", "dist"]
}
