# Services are configured as a structured object (the API_SERVICES array) in src/config/env.config.ts.
# Each entry: { prefix, docUrl, host, directPrefixes? }. `directPrefixes` are forwarded WITHOUT stripping the prefix.
REDIS_HOST=localhost
REDIS_PORT=9379
REDIS_DB=0
# REDIS_USERNAME=
# REDIS_PASSWORD=

# TLS (rediss://). Set REDIS_TLS=true to enable; the rest are optional.
# REDIS_TLS=true
# REDIS_TLS_CA_FILE=/path/to/ca.pem
# REDIS_TLS_CERT_FILE=/path/to/client-cert.pem
# REDIS_TLS_KEY_FILE=/path/to/client-key.pem
# REDIS_TLS_SERVERNAME=my-redis.example.com
# Only for self-signed certificates in non-production environments
# REDIS_TLS_REJECT_UNAUTHORIZED=false
